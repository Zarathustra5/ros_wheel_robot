#!/usr/bin/env python

import rospy
from sensor_msgs.msg import LaserScan
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
import numpy as np
import math
from collections import deque
import actionlib
from move_base_msgs.msg import MoveBaseAction, MoveBaseGoal


class RobotController:
    def __init__(self):
        rospy.init_node('lidar_teleop', anonymous=True)

        # Publishers and Subscribers
        self.cmd_vel_pub = rospy.Publisher('/cmd_vel', Twist, queue_size=1)
        self.laser_sub = rospy.Subscriber('/myrobot/rplidar/scan', LaserScan, self.laser_callback)
        self.odom_sub = rospy.Subscriber('/odom', Odometry, self.odom_callback)

        # Action client for navigation
        self.move_base_client = actionlib.SimpleActionClient('move_base', MoveBaseAction)
        rospy.loginfo("Waiting for move_base action server...")
        self.move_base_client.wait_for_server()
        rospy.loginfo("Connected to move_base action server")

        # Robot state variables
        self.current_scan = None
        self.current_position = [0.0, 0.0]
        self.current_orientation = 0.0
        self.state = 'EXPLORING'  # EXPLORING, NAVIGATING_TO_ROOM
        self.rooms_visited = set()  # Track visited rooms
        self.exploration_goals = [
            [3.0, 0.0],   # Room 1
            [-3.0, 0.0]   # Room 2
        ]
        self.navigation_goal = None
        self.last_command_time = rospy.Time.now()

        # Constants
        self.LIN_VEL = 0.3
        self.ANG_VEL = 0.6
        self.SAFETY_DISTANCE = 0.5
        self.MIN_CLEARANCE = 0.8
        self.NUM_SECTORS = 24
        self.GOAL_TOLERANCE = 0.5

        # For obstacle avoidance
        self.obstacle_detected = False
        self.turn_direction = 1  # 1 for left, -1 for right
        self.avoiding = False
        self.avoid_start_time = rospy.Time.now()

    def odom_callback(self, msg):
        """Update robot's position and orientation from odometry."""
        self.current_position[0] = msg.pose.pose.position.x
        self.current_position[1] = msg.pose.pose.position.y
        
        # Extract yaw from quaternion
        quat = msg.pose.pose.orientation
        siny_cosp = 2 * (quat.w * quat.z + quat.x * quat.y)
        cosy_cosp = 1 - 2 * (quat.y * quat.y + quat.z * quat.z)
        self.current_orientation = math.atan2(siny_cosp, cosy_cosp)

    def laser_callback(self, scan_msg):
        """Process incoming laser scan data."""
        self.current_scan = scan_msg

    def calculate_sector_data(self, ranges):
        """Divide laser scan into sectors and calculate properties for each sector."""
        num_beams = len(ranges)
        beams_per_sector = num_beams // self.NUM_SECTORS
        sector_data = []

        for i in range(self.NUM_SECTORS):
            start_idx = i * beams_per_sector
            end_idx = min((i + 1) * beams_per_sector, num_beams)
            sector_ranges = ranges[start_idx:end_idx]

            # Calculate different metrics for each sector based on its index
            if i % 4 == 0:  # Average distance
                avg_dist = sum([r if r < float('inf') else 3.5 for r in sector_ranges]) / len(sector_ranges)
                sector_info = {'avg_distance': avg_dist}
            elif i % 4 == 1:  # Minimum distance
                min_dist = min([r if r < float('inf') else 3.5 for r in sector_ranges])
                sector_info = {'min_distance': min_dist}
            elif i % 4 == 2:  # Count of valid measurements
                valid_count = sum(1 for r in sector_ranges if r < 3.0 and r > 0.1)
                sector_info = {'valid_count': valid_count}
            else:  # Weighted average (closer points have more weight)
                total_weighted = 0
                total_weight = 0
                for r in sector_ranges:
                    dist = r if r < float('inf') else 3.5
                    weight = 1.0 / max(dist, 0.1)  # Inverse distance weighting
                    total_weighted += dist * weight
                    total_weight += weight
                weighted_avg = total_weighted / total_weight if total_weight > 0 else 3.5
                sector_info = {'weighted_avg_distance': weighted_avg}

            sector_data.append(sector_info)

        return sector_data

    def find_clear_corridor_direction(self, sector_data):
        """Use sector analysis to find best corridor direction."""
        # Look for sectors with maximum clear space
        best_sector = -1
        max_clearance = 0

        for i, sec in enumerate(sector_data):
            clearance = sec.get('avg_distance', sec.get('min_distance', sec.get('weighted_avg_distance', 0)))
            if clearance > max_clearance and clearance > self.MIN_CLEARANCE:
                max_clearance = clearance
                best_sector = i

        if best_sector != -1:
            # Calculate angle for the best sector (center of the sector)
            angle_increment = (2 * math.pi) / self.NUM_SECTORS
            sector_angle = best_sector * angle_increment - math.pi
            return sector_angle, max_clearance

        return None, 0

    def check_obstacles_ahead(self, sector_data):
        """Check for obstacles in front sectors."""
        # Define front sectors (e.g., 6 sectors around 0 degrees)
        front_sectors = [23, 0, 1, 11, 12, 13]  # Approximate front sectors
        min_distances = []
        
        for idx in front_sectors:
            if idx < len(sector_data):
                min_dist = sector_data[idx].get('min_distance', 
                                              sector_data[idx].get('avg_distance', 
                                                                 sector_data[idx].get('weighted_avg_distance', float('inf'))))
                min_distances.append(min_dist)
                
        min_front_dist = min(min_distances) if min_distances else float('inf')
        return min_front_dist < self.SAFETY_DISTANCE

    def navigate_to_room(self, room_coords):
        """Send navigation goal to move_base."""
        goal = MoveBaseGoal()
        goal.target_pose.header.frame_id = "map"
        goal.target_pose.header.stamp = rospy.Time.now()
        goal.target_pose.pose.position.x = room_coords[0]
        goal.target_pose.pose.position.y = room_coords[1]
        goal.target_pose.pose.orientation.w = 1.0

        rospy.loginfo(f"Sending navigation goal to ({room_coords[0]}, {room_coords[1]})")
        self.move_base_client.send_goal(goal)
        self.navigation_goal = room_coords

    def check_if_reached_goal(self):
        """Check if robot reached the navigation goal."""
        if self.navigation_goal is None:
            return False
            
        dist_to_goal = math.sqrt(
            (self.current_position[0] - self.navigation_goal[0])**2 +
            (self.current_position[1] - self.navigation_goal[1])**2
        )
        return dist_to_goal <= self.GOAL_TOLERANCE

    def control_loop(self):
        """Main control loop."""
        rate = rospy.Rate(10)  # 10 Hz

        while not rospy.is_shutdown():
            if self.current_scan is None:
                rate.sleep()
                continue

            # Get laser ranges
            ranges = list(self.current_scan.ranges)
            
            # Replace invalid values
            processed_ranges = []
            for r in ranges:
                if r < self.current_scan.range_min or r > self.current_scan.range_max or math.isnan(r):
                    processed_ranges.append(3.5)  # Use max range for invalid readings
                else:
                    processed_ranges.append(r)

            # Calculate sector-based information
            sector_data = self.calculate_sector_data(processed_ranges)

            # Check if we're currently navigating
            if self.state == 'NAVIGATING_TO_ROOM':
                # Check if we reached the goal
                if self.check_if_reached_goal():
                    rospy.loginfo("Reached a room!")
                    self.rooms_visited.add(tuple(self.navigation_goal))
                    self.state = 'EXPLORING'
                    self.navigation_goal = None
                    
                    # Check if we've visited both rooms
                    if len(self.rooms_visited) >= 2:
                        rospy.loginfo("Successfully visited both rooms! Mission complete.")
                        break
                else:
                    # Continue waiting for navigation to complete
                    rate.sleep()
                    continue

            # If exploring, decide on next action
            if self.state == 'EXPLORING':
                # Check for obstacles ahead
                obstacle_ahead = self.check_obstacles_ahead(sector_data)
                
                if obstacle_ahead:
                    # Find best direction to go
                    best_angle, max_clearance = self.find_clear_corridor_direction(sector_data)
                    
                    if best_angle is not None:
                        # Send command to turn towards clear area
                        cmd_vel = Twist()
                        
                        # Simple proportional controller for turning
                        cmd_vel.angular.z = max(min(best_angle * 1.0, self.ANG_VEL), -self.ANG_VEL)
                        cmd_vel.linear.x = max(self.LIN_VEL / 2.0, 0.0)  # Slow down when turning
                        
                        self.cmd_vel_pub.publish(cmd_vel)
                    else:
                        # No clear path, rotate in place to find one
                        cmd_vel = Twist()
                        cmd_vel.angular.z = self.ANG_VEL
                        cmd_vel.linear.x = 0.0
                        self.cmd_vel_pub.publish(cmd_vel)
                else:
                    # No immediate obstacles, move forward and look for rooms to visit
                    cmd_vel = Twist()
                    cmd_vel.linear.x = self.LIN_VEL
                    cmd_vel.angular.z = 0.0
                    
                    # Occasionally try to navigate to unvisited rooms
                    if len(self.rooms_visited) < 2:
                        # Decide which room to visit based on distance
                        unvisited_rooms = [room for room in self.exploration_goals if tuple(room) not in self.rooms_visited]
                        if unvisited_rooms:
                            # Navigate to closest unvisited room
                            closest_room = min(unvisited_rooms, 
                                             key=lambda room: math.sqrt((self.current_position[0]-room[0])**2 + 
                                                                       (self.current_position[1]-room[1])**2))
                            self.navigate_to_room(closest_room)
                            self.state = 'NAVIGATING_TO_ROOM'
                    
                    self.cmd_vel_pub.publish(cmd_vel)

            rate.sleep()


if __name__ == '__main__':
    try:
        controller = RobotController()
        controller.control_loop()
    except rospy.ROSInterruptException:
        pass